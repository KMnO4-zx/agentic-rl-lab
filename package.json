{
  "name": "agentic-rl-lab-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:prepare": "node scripts/docs/prepare.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs --host 127.0.0.1",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:check": "node scripts/docs/check.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "cheerio": "1.2.0",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.2",
    "markdown-it-mathjax3": "4.3.2",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "overrides": {
    "vite": "6.4.3",
    "@xmldom/xmldom": "0.9.12"
  }
}
